{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VitaeContract",
  "description": "The HTTP and SSE contract for POST /v1/chat. Generated by `python -m vitae.schema`.",
  "type": "object",
  "properties": {
    "request": {
      "$ref": "#/$defs/ChatRequest"
    },
    "errorResponse": {
      "$ref": "#/$defs/ErrorResponse"
    },
    "event": {
      "$ref": "#/$defs/StreamEvent"
    },
    "outcome": {
      "$ref": "#/$defs/Outcome"
    }
  },
  "required": [
    "request",
    "errorResponse",
    "event",
    "outcome"
  ],
  "additionalProperties": false,
  "$defs": {
    "AvailabilityEvent": {
      "additionalProperties": false,
      "description": "Terminal. The profile's fixed availability answer, never generated.",
      "properties": {
        "type": {
          "const": "availability",
          "default": "availability",
          "type": "string"
        },
        "message": {
          "minLength": 1,
          "type": "string"
        },
        "action": {
          "anyOf": [
            {
              "$ref": "#/$defs/HostAction"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "type",
        "message",
        "action"
      ],
      "title": "AvailabilityEvent",
      "type": "object"
    },
    "ChatRequest": {
      "additionalProperties": false,
      "description": "One visitor message. History lives server-side under session_id; the client never sends it.",
      "properties": {
        "message": {
          "description": "Not blank. maxLength counts code points, so a JS counter must use [...s].length, not s.length.",
          "maxLength": 500,
          "pattern": "\\S",
          "type": "string"
        },
        "session_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9_-]{22}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Omit on the first turn. Unknown or expired ids start a new session."
        }
      },
      "required": [
        "message"
      ],
      "title": "ChatRequest",
      "type": "object"
    },
    "DoneEvent": {
      "additionalProperties": false,
      "description": "Terminal. complete: model stopped. length: token cap hit. withheld: a later sentence failed the output rules.",
      "properties": {
        "type": {
          "const": "done",
          "default": "done",
          "type": "string"
        },
        "finish": {
          "$ref": "#/$defs/Finish"
        }
      },
      "required": [
        "type",
        "finish"
      ],
      "title": "DoneEvent",
      "type": "object"
    },
    "ErrorEvent": {
      "additionalProperties": false,
      "description": "Terminal. Something broke after the 200 was sent. Earlier text events stay on screen.",
      "properties": {
        "type": {
          "const": "error",
          "default": "error",
          "type": "string"
        },
        "code": {
          "$ref": "#/$defs/StreamErrorCode"
        },
        "detail": {
          "type": "string"
        }
      },
      "required": [
        "type",
        "code",
        "detail"
      ],
      "title": "ErrorEvent",
      "type": "object"
    },
    "ErrorResponse": {
      "additionalProperties": false,
      "description": "Body of every non-200 response from POST /v1/chat.",
      "properties": {
        "error": {
          "$ref": "#/$defs/Rejection"
        }
      },
      "required": [
        "error"
      ],
      "title": "ErrorResponse",
      "type": "object"
    },
    "FinalCode": {
      "title": "FinalCode",
      "enum": [
        "invalid_request",
        "origin_not_allowed",
        "too_long",
        "session_limit"
      ],
      "type": "string"
    },
    "FinalRejection": {
      "additionalProperties": false,
      "description": "Retrying the same request cannot succeed.",
      "properties": {
        "code": {
          "$ref": "#/$defs/FinalCode"
        },
        "detail": {
          "description": "Developer-facing English. The UI shows its own copy per code.",
          "type": "string"
        }
      },
      "required": [
        "code",
        "detail"
      ],
      "title": "FinalRejection",
      "type": "object"
    },
    "Finish": {
      "title": "Finish",
      "enum": [
        "complete",
        "length",
        "withheld"
      ],
      "type": "string"
    },
    "HostAction": {
      "additionalProperties": false,
      "description": "Owner-defined action from the profile. The UI calls onAction(id) if the host passed one, else follows href.",
      "properties": {
        "id": {
          "pattern": "^[a-z][a-z0-9_]{0,31}$",
          "type": "string"
        },
        "label": {
          "minLength": 1,
          "type": "string"
        },
        "href": {
          "anyOf": [
            {
              "pattern": "^(#|/|https?://|mailto:|tel:)\\S*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "id",
        "label",
        "href"
      ],
      "title": "HostAction",
      "type": "object"
    },
    "Outcome": {
      "title": "Outcome",
      "description": "What the UI and the eval graders switch on. A pure function of the rejection or terminal event.",
      "type": "string",
      "enum": [
        "answered",
        "availability",
        "broken",
        "refused:unrelated",
        "refused:blocked_topic",
        "refused:injection",
        "refused:pii",
        "refused:unsafe",
        "refused:insufficient_evidence",
        "refused:output_rule",
        "rejected:rate_limited",
        "rejected:busy",
        "rejected:unavailable",
        "rejected:invalid_request",
        "rejected:origin_not_allowed",
        "rejected:too_long",
        "rejected:session_limit"
      ]
    },
    "QueuedEvent": {
      "additionalProperties": false,
      "description": "Sent when the request waits for a generation slot, and again whenever its position changes.",
      "properties": {
        "type": {
          "const": "queued",
          "default": "queued",
          "type": "string"
        },
        "position": {
          "description": "1 means next to run.",
          "exclusiveMinimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "type",
        "position"
      ],
      "title": "QueuedEvent",
      "type": "object"
    },
    "RefusalReason": {
      "title": "RefusalReason",
      "enum": [
        "unrelated",
        "blocked_topic",
        "injection",
        "pii",
        "unsafe",
        "insufficient_evidence",
        "output_rule"
      ],
      "type": "string"
    },
    "RefusedEvent": {
      "additionalProperties": false,
      "description": "Terminal. Only legal before any text event. message is the profile's refusal copy for this reason.",
      "properties": {
        "type": {
          "const": "refused",
          "default": "refused",
          "type": "string"
        },
        "reason": {
          "$ref": "#/$defs/RefusalReason"
        },
        "message": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "type",
        "reason",
        "message"
      ],
      "title": "RefusedEvent",
      "type": "object"
    },
    "Rejection": {
      "title": "Rejection",
      "oneOf": [
        {
          "$ref": "#/$defs/RetryableRejection"
        },
        {
          "$ref": "#/$defs/FinalRejection"
        }
      ],
      "discriminator": {
        "propertyName": "code",
        "mapping": {
          "rate_limited": "#/$defs/RetryableRejection",
          "busy": "#/$defs/RetryableRejection",
          "unavailable": "#/$defs/RetryableRejection",
          "invalid_request": "#/$defs/FinalRejection",
          "origin_not_allowed": "#/$defs/FinalRejection",
          "too_long": "#/$defs/FinalRejection",
          "session_limit": "#/$defs/FinalRejection"
        }
      }
    },
    "RetryableCode": {
      "title": "RetryableCode",
      "enum": [
        "rate_limited",
        "busy",
        "unavailable"
      ],
      "type": "string"
    },
    "RetryableRejection": {
      "additionalProperties": false,
      "description": "The request may succeed after retry_after_s seconds.",
      "properties": {
        "code": {
          "$ref": "#/$defs/RetryableCode"
        },
        "retry_after_s": {
          "exclusiveMinimum": 0,
          "type": "integer"
        },
        "detail": {
          "description": "Developer-facing English. The UI shows its own copy per code.",
          "type": "string"
        }
      },
      "required": [
        "code",
        "retry_after_s",
        "detail"
      ],
      "title": "RetryableRejection",
      "type": "object"
    },
    "SessionEvent": {
      "additionalProperties": false,
      "description": "Always first. The client keeps session_id in memory (no cookie, no storage) and sends it next turn.",
      "properties": {
        "type": {
          "const": "session",
          "default": "session",
          "type": "string"
        },
        "session_id": {
          "pattern": "^[A-Za-z0-9_-]{22}$",
          "type": "string"
        },
        "turns_left": {
          "description": "0 means the next request gets 429 session_limit.",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "type",
        "session_id",
        "turns_left"
      ],
      "title": "SessionEvent",
      "type": "object"
    },
    "Source": {
      "additionalProperties": false,
      "description": "A knowledge document the answer drew on.",
      "properties": {
        "id": {
          "pattern": "^[a-z][a-z0-9_]{0,31}$",
          "type": "string"
        },
        "title": {
          "minLength": 1,
          "type": "string"
        },
        "href": {
          "anyOf": [
            {
              "format": "uri",
              "maxLength": 2083,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "id",
        "title",
        "href"
      ],
      "title": "Source",
      "type": "object"
    },
    "SourcesEvent": {
      "additionalProperties": false,
      "description": "Optional, at most once, after the last text and before done.",
      "properties": {
        "type": {
          "const": "sources",
          "default": "sources",
          "type": "string"
        },
        "sources": {
          "items": {
            "$ref": "#/$defs/Source"
          },
          "minItems": 1,
          "type": "array"
        }
      },
      "required": [
        "type",
        "sources"
      ],
      "title": "SourcesEvent",
      "type": "object"
    },
    "StartedEvent": {
      "additionalProperties": false,
      "description": "A generation slot was acquired. The UI switches from queue position to the typing indicator.",
      "properties": {
        "type": {
          "const": "started",
          "default": "started",
          "type": "string"
        }
      },
      "required": [
        "type"
      ],
      "title": "StartedEvent",
      "type": "object"
    },
    "StreamErrorCode": {
      "title": "StreamErrorCode",
      "enum": [
        "generation_failed",
        "timeout",
        "internal"
      ],
      "type": "string"
    },
    "StreamEvent": {
      "title": "StreamEvent",
      "oneOf": [
        {
          "$ref": "#/$defs/SessionEvent"
        },
        {
          "$ref": "#/$defs/QueuedEvent"
        },
        {
          "$ref": "#/$defs/StartedEvent"
        },
        {
          "$ref": "#/$defs/TextEvent"
        },
        {
          "$ref": "#/$defs/SourcesEvent"
        },
        {
          "$ref": "#/$defs/DoneEvent"
        },
        {
          "$ref": "#/$defs/RefusedEvent"
        },
        {
          "$ref": "#/$defs/AvailabilityEvent"
        },
        {
          "$ref": "#/$defs/ErrorEvent"
        }
      ],
      "discriminator": {
        "propertyName": "type",
        "mapping": {
          "session": "#/$defs/SessionEvent",
          "queued": "#/$defs/QueuedEvent",
          "started": "#/$defs/StartedEvent",
          "text": "#/$defs/TextEvent",
          "sources": "#/$defs/SourcesEvent",
          "done": "#/$defs/DoneEvent",
          "refused": "#/$defs/RefusedEvent",
          "availability": "#/$defs/AvailabilityEvent",
          "error": "#/$defs/ErrorEvent"
        }
      }
    },
    "TerminalEvent": {
      "title": "TerminalEvent",
      "oneOf": [
        {
          "$ref": "#/$defs/DoneEvent"
        },
        {
          "$ref": "#/$defs/RefusedEvent"
        },
        {
          "$ref": "#/$defs/AvailabilityEvent"
        },
        {
          "$ref": "#/$defs/ErrorEvent"
        }
      ],
      "discriminator": {
        "propertyName": "type",
        "mapping": {
          "done": "#/$defs/DoneEvent",
          "refused": "#/$defs/RefusedEvent",
          "availability": "#/$defs/AvailabilityEvent",
          "error": "#/$defs/ErrorEvent"
        }
      }
    },
    "TextEvent": {
      "additionalProperties": false,
      "description": "One sentence that passed the output rules. Append verbatim; the server includes separating spaces.",
      "properties": {
        "type": {
          "const": "text",
          "default": "text",
          "type": "string"
        },
        "text": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "type",
        "text"
      ],
      "title": "TextEvent",
      "type": "object"
    }
  }
}
