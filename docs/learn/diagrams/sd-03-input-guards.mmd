flowchart LR
  API["Accepted request"] --> Norm["Normalize text"]
  Norm --> PII["PII check"]
  PII --> Rules["Injection rules"]
  Rules --> Cls["Injection classifiers<br/>ONNX, in the API"]
  Cls --> Guard["Llama Guard 1B<br/>safety classifier"]
  Guard --> Topics["Blocked topic,<br/>availability, scope"]
  Topics --> Next["On to retrieval"]
  PII -.-> Refuse["Refusal answer"]
  Rules -.-> Refuse
  Cls -.-> Refuse
  Guard -.->|"unsafe"| Refuse
  Topics -.->|"blocked or off topic"| Refuse
